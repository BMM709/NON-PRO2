            -- ระบบ Silent Aim (Hooking Metamethod)
            local rawNamecall
            rawNamecall = hookmetamethod(game, "__namecall", function(self, ...)
                local method = getnamecallmethod()
                local args = {...}

                if SilentAimEnabled and not checkcaller() then
                    if method == "Raycast" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" then
                        local target = GetClosestTarget()
                        if target then
                            if method == "Raycast" and args[1] and args[2] then
                                args[2] = (target.Position - args[1]).Unit * 1000
                                return rawNamecall(self, unpack(args))
                            end
                        end
                    end
                end
                return rawNamecall(self, ...)
            end)

